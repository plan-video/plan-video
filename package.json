{
  "name": "@plan.video/editor",
  "version": "0.206.0",
  "private": true,
  "license": "AGPL-3.0-only AND MPL-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @plan.video/web",
    "dev:web_v1": "npm run dev --workspace=@plan.video/web",
    "build": "npm run build --workspace=@plan.video/web",
    "build:web_v1": "npm run build --workspace=@plan.video/web",
    "release": "node scripts/release.mjs",
    "postinstall": "node scripts/apply-patches.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "i18n": "node scripts/i18n.mjs"
  },
  "dependencies": {
    "patch-package": "^8.0.1"
  }
}
