# The dev server's secrets, for the services it stands in for. Copy to
# apps/web/server.env, which git ignores and Vite never reads, so nothing here
# can reach the browser bundle; a build also fails if one of these values turns
# up in what it wrote. Keys here never take a VITE_ prefix. Production reads
# each service's own file in /etc/plan-video instead.

# Speech-to-text for Auto-Captions. The secret from ElevenLabs, not the key name.
# It needs the Speech to Text permission.
# Production reads it from /etc/plan-video/transcribe.env (services/transcribe).
ELEVENLABS_API_KEY=

# TikTok sandbox credentials from developers.tiktok.com. The secret must not
# use a VITE_ prefix. Restart the dev server after changing these.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set to true once video.list is added to the TikTok app, so Analytics can read
# the account's videos. Asking for a scope the app lacks stops the TikTok login.
TIKTOK_READ_VIDEOS=

# YouTube Data API OAuth client. The secret must not use a VITE_ prefix.
# Restart the dev server after changing these. While the app is in test mode,
# only Google accounts listed as test users can connect. Authorized redirects:
# http://localhost:5173/youtube/callback
# https://your-domain.example/youtube/callback
# https://www.your-domain.example/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# LinkedIn app from linkedin.com/developers, with the "Share on LinkedIn" and
# "Sign In with LinkedIn using OpenID Connect" products. The secret must not
# use a VITE_ prefix. Restart the dev server after changing these. Authorized
# redirect URLs:
# http://localhost:5173/linkedin/callback
# https://your-domain.example/linkedin/callback
# https://www.your-domain.example/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X app from console.x.com: OAuth 2.0 on, type "Web App", read and write.
# X bills the app's owner for every post (pay-per-use credits), so only paid
# plans can connect it. The secret must not use a VITE_ prefix. Restart the dev
# server after changing these. X won't take localhost, so start the dev server
# with `--host 127.0.0.1` and open http://127.0.0.1:5173. Callback URLs:
# http://127.0.0.1:5173/x/callback
# https://your-domain.example/x/callback
# https://www.your-domain.example/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Stripe, for paying for plans (services/billing). Use test-mode keys here and
# run `stripe listen --forward-to localhost:5173/api/billing/webhook` for the
# webhook secret. BILLING_DB_KEY lets the server write each person's plan and
# nothing else: make it with services/billing/scripts/db-key.mjs. None of these
# may get a VITE_ prefix. Production reads all three from
# /etc/plan-video/billing.env. Make the products and prices with
# services/billing/scripts/setup-stripe.mjs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_DB_KEY=

# The dashboard's Agent tab. An Anthropic API key from platform.claude.com.
# Production reads it from /etc/plan-video/agent.env (services/agent).
ANTHROPIC_API_KEY=
