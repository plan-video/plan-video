# Public values the site is built with. Copy to apps/web/.env, which git
# ignores, and fill in your own. Everything here can end up in the browser
# bundle, so only VITE_ keys belong in this file: the dev server and the build
# stop on any other. Secrets go in server.env (see server.env.example).

# Your Supabase project's address and its publishable key (Project Settings,
# API Keys), which is safe in a browser. Without both, sign-in is off.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Your site's address, like https://social.example.com: where sign-in links and
# the networks' logins come back to, and the agent address the dashboard shows.
# Set it for a production build. Leave it empty on the dev server, so sign-in
# comes back to localhost; empty, the networks' logins go by plan.video's
# address (src/lib/app-url.ts).
VITE_APP_URL=

# Where the dev server sends /api/publisher, the publisher service. Empty means
# VITE_APP_URL, else https://plan.video. Only the dev server reads it.
VITE_PUBLISHER_URL=

# Before launch, production builds show the waitlist and only open the app
# for invited emails. Set to false to let everyone sign up; set to true to
# try the waitlist on the dev server.
# VITE_INVITE_ONLY=false

# Where the site reports its errors, a Sentry project's DSN, like
# https://<key>@<org>.ingest.sentry.io/<project>. Empty reports nowhere and
# never loads Sentry. Only production builds report.
VITE_SENTRY_DSN=

# Umami analytics: the website's id, the address of its script, and the
# domains it counts on (comma-separated). Off while the id or script is empty.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_DOMAINS=

# Where the editor's /api/trpc calls go. Empty means this site.
VITE_API_URL=

# The address of an agent chat host for the editor, when one runs. Empty
# leaves the editor's agent chat off in a web build.
VITE_AGENT_CHAT_URL=

# Set to true to turn on the hosted agent connector (services/mcp, proxied at
# /api/mcp) on the dev server. Production builds always have it.
# VITE_CONNECTOR_DEV=true
