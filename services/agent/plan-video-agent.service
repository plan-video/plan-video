[Unit]
Description=plan.video dashboard agent
After=network-online.target
Wants=network-online.target

[Service]
# Its own user, so a bug here can't read the other services' keys; planvideo-r2
# reads r2.env, which several services share.
User=planvideo-agent
Group=planvideo-agent
SupplementaryGroups=planvideo-r2
WorkingDirectory=/opt/plan-video-agent
ExecStart=/usr/bin/node server.mjs
# /var/lib/plan-video-agent: the rate limits and spend, kept across restarts.
StateDirectory=plan-video-agent
Restart=always
RestartSec=2
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
